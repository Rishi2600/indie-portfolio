# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, sitemap and social previews.
# No trailing slash. Leave unset locally; set it once the domain exists.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Visit counter
#
# Persistent storage for the visit count. Any Redis-compatible HTTP endpoint
# works; Upstash is the one this was written against because its REST API needs
# no driver and its INCR is atomic, which is the whole requirement.
#
# With both left unset the counter falls back to a JSON file under .data/,
# which is fine for development and wrong for production: serverless instances
# do not share a disk, so the number would drift per instance.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. The Redis key holding the count. Change it to reset the counter or
# to run staging and production against one database.
VISITOR_COUNTER_KEY=
